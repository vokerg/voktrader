# Shared bearer token expected from the Java app.
EXECUTOR_API_TOKEN=change-me

# false makes the sidecar attempt a real CLOB order.
# With auth values blank, order attempts fail with a clear auth/config error.
EXECUTOR_DRY_RUN=false

# Polymarket CLOB V2 endpoint.
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_FUNDER=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=0

# Existing API credentials can be provided. If omitted and dry-run=false,
# the sidecar attempts to derive/create creds through the py_clob_client_v2 SDK.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Extra local brakes.
MAX_ORDER_AMOUNT_USD=5
# Let the JVM strategy choose FOK/FAK taker orders or GTC/GTD maker orders.
REQUIRE_FOK=false
# GTD expiration sent to Polymarket is now + 60 seconds + this value.
GTD_EXPIRATION_SECONDS=90
