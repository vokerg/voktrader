FROM python:3.12-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml ./
COPY voktrader_executor ./voktrader_executor
RUN python -m pip install --no-cache-dir .

EXPOSE 8099
CMD ["uvicorn", "voktrader_executor.main:app", "--host", "0.0.0.0", "--port", "8099"]
